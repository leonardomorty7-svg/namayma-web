---
/**
 * NAMAYMA — Hero Section
 * Chapter 01: Arrival
 * Cinematic multi-layer parallax with breathing light and ambient atmosphere
 */
---

<section
  id="hero"
  class="hero-section w-full h-screen min-h-[100svh] flex flex-col justify-center"
  aria-label="Bienvenida a NAMAYMA"
>
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="hero-content">

    <!-- Layer 2: Slow Ambient Atmosphere (Smoke/Light simulation) -->
    <div id="hero-atmosphere" class="absolute inset-0 w-[120%] h-[120%] -left-[10%] -top-[10%] opacity-40 mix-blend-screen will-change-transform">
      <div class="absolute top-1/4 left-1/4 w-[50vw] h-[50vw] bg-n-gold-lt/10 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-1/4 right-1/4 w-[60vw] h-[60vw] bg-n-mist/5 rounded-full blur-[150px]"></div>
    </div>
    
    <!-- Sophisticated Overlay System -->
    <div class="absolute inset-0 bg-n-earth/20 mix-blend-multiply z-10"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_transparent_0%,_rgba(5,4,3,0.85)_100%)] z-10"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-n-bg/20 via-transparent to-n-bg/95 z-10"></div>

    <!-- Layer 3: Breathing Light Center -->
    <div id="hero-light" class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(207,166,104,0.08)_0%,_transparent_50%)] z-10"></div>

    <!-- Layer A: Smoke (Validation Pass - Highly Visible) -->
    <div id="hero-smoke-validation" class="absolute bottom-[5%] left-1/2 -translate-x-1/2 w-full max-w-2xl h-[60%] mix-blend-screen pointer-events-none z-10 flex justify-center">
      <!-- Smoke Plume 1 -->
      <div class="absolute bottom-0 w-[400px] h-[400px] bg-[radial-gradient(ellipse_at_center,_rgba(255,240,220,0.4)_0%,_transparent_60%)] blur-[40px] animate-smoke-1"></div>
      <!-- Smoke Plume 2 -->
      <div class="absolute bottom-0 w-[500px] h-[350px] bg-[radial-gradient(ellipse_at_center,_rgba(255,255,255,0.3)_0%,_transparent_60%)] blur-[50px] animate-smoke-2"></div>
      <!-- Smoke Plume 3 -->
      <div class="absolute bottom-0 w-[300px] h-[450px] bg-[radial-gradient(ellipse_at_center,_rgba(220,200,180,0.5)_0%,_transparent_60%)] blur-[35px] animate-smoke-3"></div>
    </div>

    <!-- Layer B: Floating Dust Particles (DIAGNOSTIC) -->
    <div id="hero-dust" class="absolute inset-0 z-[15] pointer-events-none overflow-hidden"></div>

    <!-- ── Main Hero Content ──────────────────────────────── -->
    <!-- Centered perfectly with room to breathe -->
    <div class="relative z-20 container-ritual flex flex-col items-center justify-center h-full text-center mt-12 pointer-events-auto">

    <!-- Floating top label -->
    <div id="hero-content-wrapper" class="flex flex-col items-center w-full">
      <div class="hero-element flex items-center justify-center gap-5 mb-10 opacity-0">
        <div class="divider-gold !w-8 md:!w-12"></div>
        <span class="label-sacred text-n-gold-lt tracking-[0.3em]">Inmersión Consciente</span>
        <div class="divider-gold !w-8 md:!w-12"></div>
      </div>

      <!-- Massive Cinematic Headline -->
      <h1 id="hero-headline" class="hero-element font-serif text-[12vw] md:text-[8rem] lg:text-[10rem] leading-none md:whitespace-nowrap text-n-cream mb-10 opacity-0" aria-label="Regresa a ti" style="text-shadow: 0 2px 40px rgba(0,0,0,0.5);">
        Regresa <em class="not-italic text-gold-gradient">a&nbsp;ti.</em>
      </h1>

      <!-- Sub-copy -->
      <p class="hero-element font-sans mb-16 font-light opacity-0" style="max-width: 580px; margin: 0 auto; text-align: center; line-height: 1.75; font-size: var(--text-body-lg); color: rgba(245, 240, 232, 0.82); text-shadow: 0 1px 25px rgba(0,0,0,0.7);">
        Un ritual de reconexión profunda. Meditación, danza consciente, sanación sonora y respiración en un encuentro sagrado.
      </p>

      <!-- CTA & Microcopy -->
      <div class="hero-element flex flex-col items-center opacity-0" style="margin-top: 2.5rem;">
        <a href="#reservar" class="btn-gold" aria-label="Reserva tu lugar" style="display: inline-block; width: auto; padding: 1rem 3rem; letter-spacing: 0.2em; font-size: 0.75rem;">
          Reservar Lugar
        </a>
        <span class="font-sans" style="margin-top: 1rem; font-size: 0.72rem; letter-spacing: 0.25em; color: rgba(201, 169, 110, 0.9); text-shadow: 0 1px 12px rgba(0,0,0,0.8); text-transform: uppercase;">
          18 Julio 2026 · Cupos limitados
        </span>
      </div>
    </div>

  </div>

  <!-- ── Scroll Indicator ─────────────────────── -->
  <div
    id="hero-scroll"
    class="absolute bottom-12 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center opacity-0"
    aria-hidden="true"
  >
    <div class="scroll-indicator">
      <span>DESCENDER</span>
      <div class="scroll-arrow">
        <svg width="12" height="20" viewBox="0 0 12 20" fill="none">
          <path d="M6 0v16M1 11l5 5 5-5" stroke="#C9A96E" stroke-width="1" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </div>
  </div>
</section>

<style>
.hero-section {
  position: relative;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: -25%;
  background-image:
    radial-gradient(ellipse 65% 55% at 50% 45%, rgba(4,2,1,0.78) 0%, rgba(4,2,1,0.55) 45%, rgba(4,2,1,0.10) 100%),
    linear-gradient(to bottom, rgba(4,2,1,0.60) 0%, rgba(4,2,1,0.20) 25%, rgba(4,2,1,0.20) 65%, rgba(4,2,1,0.75) 100%),
    url('/images/hero-bg.jpg');
  background-size: cover;
  background-position: center;
  will-change: transform;
  z-index: 0;
}

.hero-content {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.scroll-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  color: rgba(201, 169, 110, 0.7);
  font-size: 0.6rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
}
.scroll-arrow {
  animation: bounce 2s ease-in-out infinite;
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); opacity: 0.7; }
  50% { transform: translateY(6px); opacity: 1; }
}
</style>

<script>
  import { loadGSAP, fadeReveal, blurReveal } from '../../lib/gsap';

  document.addEventListener('DOMContentLoaded', async () => {
    // Parallax logic
    (() => {
      const bg = document.querySelector('.hero-bg') as HTMLElement;
      if (!bg) return;
      const onScroll = () => {
        const scrollY = window.scrollY;
        const scale = 1 + scrollY * 0.0003;
        bg.style.transform = `translateY(${scrollY * 0.5}px) scale(${Math.min(scale, 1.15)})`;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    })();

    const gsap = await loadGSAP();
    if (!gsap) return;

    const heroSection = document.getElementById('hero');
    if (!heroSection) return;

    const ctx = gsap.context(() => {
      // Breathing Light Animation (Continuous)
      gsap.to('#hero-light', {
        opacity: 0.4,
        duration: 4,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });

      // Atmosphere drifting (Continuous)
      gsap.to('#hero-atmosphere', {
        x: '3%',
        y: '2%',
        rotation: 1,
        duration: 20,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });

      // Cinematic initial reveal
      blurReveal('#hero-headline', { delay: 0.2, duration: 2.2, y: 15, blur: 5 });
      fadeReveal('div.hero-element, p.hero-element', { delay: 0.8, stagger: 0.2, duration: 1.8, y: 20 });
      gsap.to('#hero-scroll', { opacity: 1, duration: 2.5, delay: 2.5, ease: 'sacred' });

      // Layer B: Subtle Dust Particles
      const dustContainer = document.getElementById('hero-dust');
      if (dustContainer) {
        for (let i = 0; i < 60; i++) { // DIAGNOSTIC: 60 particles
          const p = document.createElement('div');
          p.className = 'hero-dust-particle absolute rounded-full bg-n-gold-lt mix-blend-screen';
          
          const size = Math.random() * 4 + 2; // DIAGNOSTIC: 2px to 6px
          p.style.width = `${size}px`;
          p.style.height = `${size}px`;
          
          // Distribution: central light beam, title area, altar
          p.style.left = `${10 + Math.random() * 80}%`;
          p.style.bottom = `${Math.random() * 70}%`;
          p.style.filter = `blur(1px)`;
          p.style.opacity = '0';
          
          dustContainer.appendChild(p);
        }
      }

      gsap.utils.toArray('.hero-dust-particle').forEach((p: any) => {
        // DIAGNOSTIC: Clearly visible movement
        gsap.to(p, {
          y: `${Math.random() > 0.5 ? '+' : '-'}=${40 + Math.random() * 60}`,
          x: `${Math.random() > 0.5 ? '+' : '-'}=${40 + Math.random() * 60}`,
          duration: 10 + Math.random() * 10,
          ease: 'sine.inOut',
          yoyo: true,
          repeat: -1,
          delay: Math.random() * -10
        });
        
        // DIAGNOSTIC: Visible immediately, opacity 0.4 to 0.8
        gsap.to(p, {
          opacity: 0.4 + Math.random() * 0.40,
          duration: 3 + Math.random() * 4,
          ease: 'sine.inOut',
          yoyo: true,
          repeat: -1,
          delay: Math.random() * -5
        });
      });

    }, heroSection);

    document.addEventListener('astro:before-swap', () => ctx.revert(), { once: true });
  });
</script>
