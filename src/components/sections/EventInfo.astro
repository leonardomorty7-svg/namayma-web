---
/**
 * NAMAYMA — Event Info Section
 * Temporary section to display event details.
 * TODO: The client will provide the final event information (Location, Time, Food, Price).
 * Replace the placeholder texts here once provided.
 */
const infoItems = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-[#C9A96E]"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>`,
    title: 'Lugar',
    desc: 'Pendiente de confirmación por la organización',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-[#C9A96E]"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
    title: 'Horario',
    desc: 'Pendiente de confirmación por la organización',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-[#C9A96E]"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>`,
    title: 'Alimentación',
    desc: 'Información pendiente de confirmación',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-[#C9A96E]"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle></svg>`,
    title: 'Inversión',
    desc: 'Pendiente de confirmación por la organización',
  }
];
---

<section id="informacion" class="relative py-24 md:py-32 overflow-hidden bg-[#080808]">
  <div class="container-ritual relative z-10">
    <!-- Header -->
    <div class="text-center mb-16 opacity-0" id="info-header">
      <div class="section-eyebrow mb-6 text-[#C9A96E] uppercase">
        INFORMACIÓN DEL ENCUENTRO
      </div>
      <h2 class="font-serif text-[clamp(2.5rem,5vw,4rem)] text-[#F5F0E8] font-light leading-tight max-w-[600px] mx-auto">
        Detalles de la experiencia
      </h2>
    </div>

    <!-- Info Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-[800px] mx-auto">
      {infoItems.map((item, i) => (
        <div class="info-card opacity-0 bg-[#0a0a0a] border border-[#C9A96E]/20 p-10 text-center rounded-sm transition-all duration-500 hover:border-[#C9A96E]/40 hover:-translate-y-1">
          <div class="mb-4 opacity-80 flex justify-center" set:html={item.icon}></div>
          <h3 class="font-serif text-2xl text-[#F5F0E8] mb-3 tracking-wide">{item.title}</h3>
          <!-- TODO: Update placeholder text once final values are provided -->
          <p class="font-sans text-[0.9rem] text-[#888] font-light leading-[1.6]">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { loadGSAP, fadeReveal } from '../../lib/gsap';

  document.addEventListener('DOMContentLoaded', async () => {
    const gsap = await loadGSAP();
    if (!gsap) return;

    const ctx = gsap.context(() => {
      // Reveal header
      fadeReveal('#info-header', {
        scrollTrigger: { trigger: '#informacion', start: 'top 85%' }
      });

      // Reveal cards stagger
      gsap.fromTo('.info-card', 
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 1,
          ease: 'power2.out',
          stagger: 0.15,
          scrollTrigger: {
            trigger: '.info-card',
            start: 'top 85%',
          }
        }
      );
    }, document.getElementById('informacion'));

    document.addEventListener('astro:before-swap', () => ctx.revert(), { once: true });
  });
</script>
