---
/**
 * NAMAYMA — Base Layout
 * Global HTML shell: SEO, fonts, CSS, Lenis + GSAP init
 */
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = 'NAMAYMA — Una Experiencia de Inmersión Consciente',
  description = 'NAMAYMA es un ritual de reconexión profunda. Meditación, danza consciente, sanación sonora, breathwork y rituales ancestrales en un solo encuentro sagrado.',
  image = '/images/hero-bg.jpg',
  canonicalURL = Astro.url.href,
} = Astro.props;

const siteURL = 'https://namayma.com';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteURL}${image}`} />
    <meta property="og:site_name" content="NAMAYMA" />
    <meta property="og:locale" content="es_MX" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}${image}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0D0B09" />
    <meta name="robots" content="index, follow" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300;1,9..40,400&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Event",
        "name": "NAMAYMA",
        "description": description,
        "url": siteURL,
        "organizer": { "@type": "Organization", "name": "NAMAYMA", "url": siteURL },
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "eventStatus": "https://schema.org/EventScheduled",
        "offers": { "@type": "Offer", "availability": "https://schema.org/LimitedAvailability" },
      })}
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <slot />

    <script>
      import { initLenis } from '../lib/lenis';
      import { loadGSAP } from '../lib/gsap';
      document.addEventListener('DOMContentLoaded', async () => {
        await loadGSAP();
        initLenis();
      });
    </script>
  </body>
</html>
